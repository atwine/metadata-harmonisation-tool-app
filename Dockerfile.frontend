FROM node:20-slim

WORKDIR /app

COPY package.json package-lock.json* bun.lock* ./
RUN npm ci

COPY . .

EXPOSE 8080

# Dev server, not a production build: this app is TanStack Start + the
# Cloudflare Workers vite plugin, so `npm run build` produces a Workers
# bundle, not a plain static/Node artifact `vite preview` can serve. For a
# local single-user/single-org tool, the dev server is an acceptable target.
# The shared vite config (@lovable.dev/vite-tanstack-config) already binds
# host "::" (all interfaces) and port 8080 by default — no CLI flags needed.
CMD ["npm", "run", "dev"]
